# 复制为 .env 使用；环境变量优先级高于此文件。

# 主密钥：用于 JWT 签名与 Provider 密钥加密（Fernet 派生）。
# 留空则自动生成并持久化到 <数据目录>/.secret_key。生产环境建议显式设置。
LIBERASTRA_SECRET_KEY=

# 数据库 URL。留空使用 SQLite：<数据目录>/liberastra.db
# PostgreSQL 示例：postgresql+psycopg://liberastra:liberastra@localhost:5432/liberastra
LIBERASTRA_DATABASE_URL=

# 数据目录（输出、上传、音色、工作流等）
LIBERASTRA_DATA_DIR=./data

# 服务监听（容器/进程内）
LIBERASTRA_HOST=0.0.0.0
LIBERASTRA_PORT=8000

# Docker 发布到宿主机的端口（compose ports 左侧）。8000 被占用时可改为 18000
LIBERASTRA_PUBLISH_PORT=8000

# Docker 构建源。默认使用清华 PyPI；海外可改为 https://pypi.org/simple
LIBERASTRA_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
LIBERASTRA_PIP_DEFAULT_TIMEOUT=120
LIBERASTRA_PIP_RETRIES=10

# 基础镜像。默认 Docker Hub；国内可换成实际可用的 registry 镜像地址
LIBERASTRA_PYTHON_IMAGE=python:3.11-slim
LIBERASTRA_NODE_IMAGE=node:22-alpine
