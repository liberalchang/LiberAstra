# 复制为 .env 后按这台显卡主机修改。不要把填了密钥的 .env 提交进仓库。

# 调用 /api/v1 时的密钥。留空则不校验。
LIBER_SPEECH_API_KEY=

# cuda 或 cpu。容器里一般用 cuda，并且只暴露一张卡。
LIBER_SPEECH_DEVICE=cuda

# 请求不传 model 时使用。可选：large-v3、large-v3-turbo、qwen3-asr-1.7b。
# 也可以写成容器里的绝对目录，目录内要有 model.bin 或 config.json。
LIBER_SPEECH_ASR_MODEL=large-v3

# Qwen3-ASR 的时间戳模型。留空时自动找 /models/Qwen3-ForcedAligner-0.6B，
# 没有平铺目录就用 Hugging Face 缓存里的 Qwen/Qwen3-ForcedAligner-0.6B。
LIBER_SPEECH_QWEN_ALIGNER_MODEL=

# 请求不传 model 时使用。11 个包：
# multilingual_v3 multilingual_v2 turbo nano standard zh-cmn es-mx pt-br es-es pt-pt hi
# multilingual 仍是 multilingual_v2 的别名。
LIBER_SPEECH_TTS_MODEL=multilingual_v3

# 宿主机模型目录，挂进容器后是 /models。
LIBER_SPEECH_MODELS_DIR=/home/ps/workspace/liberastra-speech/models

# 1 表示只读本地缓存，不再访问 Hugging Face。
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
