# 复制为 .env 后按这台显卡主机修改。不要把填了密钥的 .env 提交进仓库。

# 调用 /api/v1 时的密钥。留空则不校验。
LIBER_DEPTH_API_KEY=

# cuda 或 cpu。容器里一般用 cuda。
LIBER_DEPTH_DEVICE=cuda

# 请求不传 model 时使用。对应模型目录里的文件名（不含 .pt）。
LIBER_DEPTH_MODEL=dpt_swin2_large_384

# 宿主机模型目录，挂进容器后是 /models。
# 需要 dpt_swin2_large_384.pt 或 dpt_beit_large_512.pt 这类 MiDaS 权重。
LIBER_DEPTH_MODELS_DIR=/models
